                                                     rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Afbeelding> ,
                                                                     <https://schema.org/Event> ;
                                                     rdf:comment "Class for official announcements, treated as events "@en ;
                                                     rdfs:label "Bekendmaking"@nl .


###  https://data.oorlogsbronnen.nl/schema#Certificate
<https://data.oorlogsbronnen.nl/schema#Certificate> rdf:type owl:Class ;
                                                    rdfs:subClassOf <https://schema.org/CreativeWork> ;
                                                    rdf:comment "Class for archival certificates"@en ;
                                                    rdfs:label "Akte"@nl .


###  https://data.oorlogsbronnen.nl/schema#Interview
<https://data.oorlogsbronnen.nl/schema#Interview> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://schema.org/CreativeWork> ;
                                                  rdf:comment "Class for interviews"@en ;
                                                  rdfs:label "Interview"@nl .


###  https://data.oorlogsbronnen.nl/schema#InterviewSegment
<https://data.oorlogsbronnen.nl/schema#InterviewSegment> rdf:type owl:Class ;
                                                         rdfs:subClassOf <https://schema.org/CreativeWork> ;
                                                         rdf:comment "Class for interviews segments"@en ;
                                                         rdfs:label "Fragment"@nl .


###  https://data.oorlogsbronnen.nl/schema#Monument
<https://data.oorlogsbronnen.nl/schema#Monument> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://schema.org/CreativeWork> ;
                                                 rdf:comment "Class for monuments"@en ;
                                                 rdfs:label "Monument"@nl .


###  https://data.oorlogsbronnen.nl/schema#Rights
<https://data.oorlogsbronnen.nl/schema#Rights> rdf:type owl:Class ;
                                               rdf:comment "Rights Statement"@en ;
                                               rdfs:label "Rechten"@nl .


###  https://data.oorlogsbronnen.nl/schema#Webpagina
<https://data.oorlogsbronnen.nl/schema#Webpagina> rdf:type owl:Class ;
                                                  rdf:comment "Class for all web content created by Oorlogsbronnen"@en ;
                                                  rdfs:label "Webpagina"@nl .


###  https://personsincontext.org/model#PersonObservation
<https://personsincontext.org/model#PersonObservation> rdf:type owl:Class ;
                                                       rdf:comment "Persoon zoals geobserveerd in een bron"@nl ;
                                                       rdfs:label "Persoonsvermelding"@nl .


###  https://personsincontext.org/model#PersonReconstruction
<https://personsincontext.org/model#PersonReconstruction> rdf:type owl:Class ;
                                                          rdf:comment "Persoon gemodelleerd op basis van een of meer persoonsvermeldingen"@nl ;
                                                          rdfs:label "Persoonsreconstructie"@nl .


###  https://schema.org/ArchiveComponent
<https://schema.org/ArchiveComponent> rdf:type owl:Class .


###  https://schema.org/CreativeWork
<https://schema.org/CreativeWork> rdf:type owl:Class .


###  https://schema.org/Event
<https://schema.org/Event> rdf:type owl:Class .


###  https://schema.org/ImageObject
<https://schema.org/ImageObject> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Afbeelding> ;
                                 rdfs:label "Afbeelding"@nl .


###  https://schema.org/Photograph
<https://schema.org/Photograph> rdf:type owl:Class ;
                                rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Afbeelding> .


###  https://schema.org/SheetMusic
<https://schema.org/SheetMusic> rdf:type owl:Class ;
                                rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Afbeelding> .


###  https://schema.org/VisualArtwork
<https://schema.org/VisualArtwork> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Afbeelding> .


###  https://schema.org/WebPage
<https://schema.org/WebPage> rdf:type owl:Class ;
                             rdfs:subClassOf <https://data.oorlogsbronnen.nl/schema#Webpagina> .


