@base <https://data.oorlogsbronnen.nl/oorlogsbronnen-shapes#> .

<https://data.oorlogsbronnen.nl/oorlogsbronnen-shapes> rdf:type owl:Ontology ;
                                                        owl:imports <http://datashapes.org/dash> ;
                                                        rdfs:label "Oorlogsbronnen SHACL Shapes"@nl .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#comment
rdf:comment rdf:type owl:AnnotationProperty .


###  https://data.oorlogsbronnen.nl/schema#genoemde
<https://data.oorlogsbronnen.nl/schema#genoemde> rdf:comment "Een persoon die genoemd wordt bij een bekendmaking"@nl ;
                                                 rdfs:label "genoemde"@nl ;
                                                 rdf:type owl:AnnotationProperty ;
                                                 rdfs:subPropertyOf <https://schema.org/actor> .


###  https://data.oorlogsbronnen.nl/schema#opdrachtgever
<https://data.oorlogsbronnen.nl/schema#opdrachtgever> rdf:comment "Een persoon die de opdrachtgever was van een bekendmaking"@nl ;
                                                      rdfs:label "opdrachtgever"@nl ;
                                                      rdf:type owl:AnnotationProperty ;
                                                      rdfs:subPropertyOf <https://schema.org/actor> .


###  https://data.oorlogsbronnen.nl/schema#slachtoffer
<https://data.oorlogsbronnen.nl/schema#slachtoffer> rdf:comment "Een persoon die slachtoffer was in een gebeurtenis"@nl ;
                                                    rdfs:label "slachtoffer"@nl ;
                                                    rdf:type owl:AnnotationProperty ;
                                                    rdfs:subPropertyOf <https://schema.org/actor> .


###  https://schema.org/actor
<https://schema.org/actor> rdf:type owl:AnnotationProperty .


