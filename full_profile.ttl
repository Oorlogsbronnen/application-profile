    rdfs:label "Gehuwd"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/18966> ;
    rdfs:subClassOf schema:Event .

niod:Geland a rdfs:Class ;
    rdfs:label "Geland"@nl ;
