picom:PersonObservation a rdfs:Class ;
    rdfs:label "Persoonsvermelding"@nl ;
    rdf:comment "Persoon zoals geobserveerd in een bron"@nl .

picom:PersonReconstruction a rdfs:Class ;
    rdfs:label "Persoonsreconstructie"@nl ;
    rdf:comment "Persoon gemodelleerd op basis van een of meer persoonsvermeldingen"@nl .

:genoemde a rdf:Property ;
    rdfs:label "genoemde"@nl ;
    rdf:comment "Een persoon die genoemd wordt bij een bekendmaking"@nl ;
    rdfs:subPropertyOf schema:actor .

:opdrachtgever a rdf:Property ;
    rdfs:label "opdrachtgever"@nl ;
    rdf:comment "Een persoon die de opdrachtgever was van een bekendmaking"@nl ;
    rdfs:subPropertyOf schema:actor .

:slachtoffer a rdf:Property ;
    rdfs:label "slachtoffer"@nl ;
    rdf:comment "Een persoon die slachtoffer was in een gebeurtenis"@nl ;
    rdfs:subPropertyOf schema:actor .

<https://data.oorlogsbronnen.nl/oorlogsbronnen-shapes> a owl:Ontology ;
    rdfs:label "Oorlogsbronnen SHACL Shapes"@nl ;
    owl:imports <http://datashapes.org/dash> .

default1:ArchiveShape a sh:NodeShape ;
    sh:name "Archieven en Archiefstukken"@nl ;
    sh:node default1:CreativeWorkShape ;
    sh:property [ sh:description "Mate van openbaarheid van het archief of archiefstuk"@nl ;
            sh:name "Openbaarheid"@nl ;
            sh:node default1:Rule_accessRights ;
            sh:path dct:accessRights ] ;
    sh:targetClass niod1:Archive,
        niod1:ArchiveFile .

default1:BekendmakingShape a sh:NodeShape ;
    sh:name "Bekendmakingen"@nl ;
    sh:node default1:CreativeWorkShape ;
    sh:property [ sh:description "Transcriptie van de tekst op het document"@nl ;
            sh:name "Tekst"@nl ;
            sh:node default1:Rule_text ;
            sh:path schema:text ],
        [ sh:description "Publicatiedatum van het document"@nl ;
            sh:name "Publicatiedatum"@nl ;
            sh:node default1:Rule_datePublished ;
            sh:path schema:datePublished ] ;
    sh:targetClass niod1:Bekendmaking .

default1:ConceptShape a sh:NodeShape ;
    sh:description "Een abstract idee of een term uit een gecontroleerde woordenlijst of thesaurus."@nl ;
    sh:name "Thesaurusconcept"@nl ;
    sh:property [ sh:name "Type (RDF)"@nl ;
            sh:node default1:Rule_type ;
            sh:path rdf:type ],
        [ sh:description "De officiële naam van het concept in de thesaurus."@nl ;
            sh:name "Voorkeursterm"@nl ;
            sh:node default1:Rule_prefLabel ;
            sh:path skos:prefLabel ],
        [ sh:description "Synoniemen of andere schrijfwijzen van het concept."@nl ;
            sh:name "Alternatieve term"@nl ;
            sh:node default1:Rule_altLabel ;
            sh:path skos:altLabel ],
        [ sh:description "Termen zoals spelfouten die wel doorzoekbaar moeten zijn, maar niet getoond worden."@nl ;
            sh:name "Verborgen term"@nl ;
            sh:node default1:Rule_hiddenLabel ;
            sh:path skos:hiddenLabel ],
        [ sh:description "Een tekstuele beschrijving van het concept."@nl ;
            sh:name "Beschrijving"@nl ;
            sh:node default1:Rule_scopeNote ;
            sh:path skos:scopeNote ],
        [ sh:description "Een tekstuele uitleg van de betekenis van het concept."@nl ;
            sh:name "Definitie"@nl ;
            sh:node default1:Rule_definition ;
            sh:path skos:definition ],
        [ sh:description "De overkoepelende thesaurus of conceptenlijst waar dit concept deel van uitmaakt."@nl ;
            sh:name "Behoort tot thesaurus"@nl ;
            sh:node default1:Rule_inScheme ;
            sh:path skos:inScheme ],
        [ sh:description "Verwijzing naar een concept dat hoger in de hiërarchie staat."@nl ;
            sh:name "Breder concept"@nl ;
            sh:node default1:Rule_broader ;
            sh:path skos:broader ],
        [ sh:description "Verwijzing naar een concept dat lager in de hiërarchie staat."@nl ;
            sh:name "Kleiner concept"@nl ;
            sh:node default1:Rule_narrower ;
            sh:path skos:narrower ],
        [ sh:description "Verwijzing naar een concept dat inhoudelijk verwant is, maar niet in de hiërarchie staat."@nl ;
            sh:name "Gerelateerd concept"@nl ;
            sh:node default1:Rule_related ;
            sh:path skos:related ],
        [ sh:description "Verwijzing naar een identiek concept in een externe bron (bijv. AAT of WO2-thesaurus)."@nl ;
            sh:name "Exacte match"@nl ;
            sh:node default1:Rule_exactMatch ;
            sh:path skos:exactMatch ],
        [ sh:description "Locatie van het concept."@nl ;
            sh:name "Locatie"@nl ;
            sh:node default1:Rule_wgsLocation ;
            sh:path wgs1:location ],
        [ sh:description "Breedtegraad van de locatie van het concept."@nl ;
            sh:name "Latitude"@nl ;
            sh:node default1:Rule_lat ;
            sh:path wgs1:lat ],
        [ sh:description "Lengtegraad van de locatie van het concept."@nl ;
            sh:name "Longitude"@nl ;
            sh:node default1:Rule_long ;
            sh:path wgs1:long ],
        [ sh:name "Aanmaakdatum"@nl ;
            sh:node default1:Rule_created ;
            sh:path dct:created ],
        [ sh:name "Wijzigingsdatum"@nl ;
            sh:node default1:Rule_modified ;
            sh:path dct:modified ],
        [ sh:name "Startdatum"@nl ;
            sh:node default1:Rule_startDate ;
            sh:path schema:startDate ],
        [ sh:name "Einddatum"@nl ;
            sh:node default1:Rule_endDate ;
            sh:path schema:endDate ] ;
    sh:targetClass skos:Concept .

default1:DatasetShape a sh:NodeShape ;
    sh:description "Records  maken altijd onderdeel uit van een dataset."@nl ;
    sh:name "Dataset waaruit een record afkomstig is"@nl ;
    sh:property [ sh:description "De unieke identifier van de dataset."@nl ;
            sh:name "Identifier"@nl ;
            sh:node default1:Rule_identifier_schema ;
            sh:path schema:identifier ],
        [ sh:description "Classificatie van de entiteit als schema:Dataset"@nl ;
            sh:name "Type entiteit"@nl ;
            sh:node default1:Rule_type ;
            sh:path rdf:type ],
        [ sh:name "Naam van de dataset"@nl ;
            sh:node default1:Rule_name ;
            sh:path schema:name ],
        [ sh:name "Beschrijving van de dataset"@nl ;
            sh:node default1:Rule_description_schema ;
            sh:path schema:description ],
        [ sh:name "Bronverwijzing voor de dataset"@nl ;
            sh:node default1:Rule_url ;
            sh:path schema:url ],
        [ sh:name "Leverancier van de dataset"@nl ;
            sh:node default1:Rule_provider ;
            sh:path schema:provider ] ;
    sh:targetClass schema:Dataset .

default1:EventShape a sh:NodeShape ;
    sh:description ""@nl ;
    sh:name "Gebeurtenis"@nl ;
    sh:property [ sh:description "Classificatie van de entiteit als schema:Event"@nl ;
            sh:name "Type entiteit"@nl ;
            sh:node default1:Rule_type ;
            sh:path rdf:type ],
        [ sh:description "Classificatie van de gebeurtenis als persoonlijke gebeurtenis uit de WO2 thesaurus"@nl ;
            sh:name "type gebeurtenis"@nl ;
            sh:node default1:Rule_additionalType ;
            sh:path schema:additionalType ],
        [ sh:description "De naam van de gebeurtenis."@nl ;
            sh:name "Naam"@nl ;
            sh:node default1:Rule_name ;
            sh:path schema:name ],
        [ sh:name "Locatie"@nl ;
            sh:node default1:Rule_location ;
            sh:path schema:location ],
        [ sh:name "Beginlocatie"@nl ;
            sh:node default1:Rule_fromLocation ;
            sh:path schema:fromLocation ],
        [ sh:name "Eindlocatie"@nl ;
            sh:node default1:Rule_toLocation ;
            sh:path schema:toLocation ],
        [ sh:name "Persoon in de gebeurtenis"@nl ;
            sh:node default1:Rule_actor ;
            sh:path schema:actor ],
        [ sh:name "Grotere gebeurtenis"@nl ;
            sh:node default1:Rule_superEvent ;
            sh:path schema:superEvent ],
        [ sh:description "De originele bron waaruit deze informatie afkomstig is."@nl ;
            sh:name "Primaire bron"@nl ;
            sh:node default1:Rule_hadPrimarySource ;
            sh:path prov:hadPrimarySource ],
        [ sh:name "Startdatum"@nl ;
            sh:node default1:Rule_startDate ;
            sh:path schema:startDate ],
        [ sh:name "Einddatum"@nl ;
            sh:node default1:Rule_endDate ;
            sh:path schema:endDate ] ;
    sh:targetClass schema:Event .

default1:MediaShape a sh:NodeShape ;
    sh:name "Audio en Video objecten"@nl ;
    sh:node default1:CreativeWorkShape ;
    sh:property [ sh:name "Url van het media object"@nl ;
            sh:node default1:Rule_contentUrl ;
            sh:path schema:contentUrl ] ;
    sh:targetClass schema:AudioObject,
        schema:VideoObject .

default1:MonumentShape a sh:NodeShape ;
    sh:name "Monumenten"@nl ;
    sh:node default1:CreativeWorkShape ;
    sh:property [ sh:description "Breedtegraad van de locatie van het monument."@nl ;
            sh:name "Latitude"@nl ;
            sh:node default1:Rule_lat_schema ;
            sh:path schema:latitude ],
        [ sh:description "Lengtegraad van de locatie van het monument"@nl ;
            sh:name "Longitude"@nl ;
            sh:node default1:Rule_long_schema ;
            sh:path schema:longitude ] ;
    sh:targetClass niod1:Monument .

default1:PersoonsvermeldingShape a sh:NodeShape ;
    sh:description "Een observatie of vermelding van een persoon binnen een specifieke historische bron."@nl ;
    sh:name "Persoonsvermelding"@nl ;
    sh:node default1:PersoonReconstructionShape ;
    sh:property [ sh:description "Voor persoonsvermeldingen wordt prov:wasDerivedFrom niet toegestaan."@nl ;
            sh:maxCount 0 ;
            sh:name "Afgeleid van (niet toegestaan)"@nl ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "De roepnaam of eerste voornaam van de persoon."@nl ;
            sh:name "Voornaam"@nl ;
            sh:node default1:Rule_givenName ;
            sh:path schema:givenName ],
        [ sh:description "De geslachtsnaam, inclusief tussenvoegsels."@nl ;
            sh:name "Achternaam"@nl ;
            sh:node default1:Rule_familyName ;
            sh:path schema:familyName ],
        [ sh:description "De voorletters van de persoon."@nl ;
            sh:name "Initialen"@nl ;
            sh:node default1:Rule_initials ;
            sh:path pnv:initials ],
        [ sh:description "Het beroep of de maatschappelijke rol van de persoon."@nl ;
            sh:name "Beroep of functie"@nl ;
            sh:node default1:Rule_hasOccupation ;
            sh:path schema:hasOccupation ],
        [ sh:description "Woonplaats of laatst bekende adres."@nl ;
            sh:name "Adresgegevens"@nl ;
            sh:node default1:Rule_address ;
            sh:path schema:address ],
        [ sh:description "De originele bron waaruit deze informatie afkomstig is."@nl ;
            sh:name "Primaire bron"@nl ;
            sh:node default1:Rule_hadPrimarySource ;
            sh:path prov:hadPrimarySource ],
        [ sh:description "Een korte beschrijving van de persoon of diens rol tijdens de Tweede Wereldoorlog."@nl ;
            sh:name "Biografische schets"@nl ;
            sh:node default1:Rule_description_schema ;
            sh:path schema:description ] ;
    sh:targetClass picom1:PersonObservation .

default1:Rule_additionalName sh:node default1:Base_String ;
    sh:path schema:additionalName .

default1:Rule_caption sh:maxCount 1 ;
    sh:node default1:Base_String ;
    sh:path schema:caption .

