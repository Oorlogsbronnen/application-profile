@prefix : <http://data.oorlogsbronnen.nl/schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmit: <http://purl.org/dc/dcmitype/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix default1: <https://data.oorlogsbronnen.nl/schema#> .
@prefix niod: <https://data.niod.nl/> .
@prefix niod1: <http://data.niod.nl/WO2_Thesaurus/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix picom: <https://personsincontext.org/model#> .
@prefix picom1: <https://personsincontext.org/model/#> .
@prefix pnv: <https://w3id.org/pnv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
