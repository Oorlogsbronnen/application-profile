default1:CreativeWorkShape a sh:NodeShape ;
    sh:description "Verschillende typen bronnen en objecten die binnen de collectie worden beschreven, zoals artikelen, foto's en kunstwerken."@nl ;
    sh:name "Bronnen en Objecten"@nl ;
    sh:property [ sh:name "Thumbnail"@nl ;
            sh:node default1:Rule_thumbnail ;
            sh:path schema:thumbnail ],
        [ sh:name "Identifier (DC)"@nl ;
            sh:node default1:Rule_identifier_dc ;
            sh:path dc:identifier ],
        [ sh:name "Type (RDF)"@nl ;
            sh:node default1:Rule_type ;
            sh:path rdf:type ],
        [ sh:name "Type (DC)"@nl ;
            sh:node default1:Rule_type_dc ;
            sh:path dc:type ],
        [ sh:name "Type (DC)"@nl ;
            sh:node default1:Rule_format ;
            sh:path dc:format ],
        [ sh:description "Dit object of archiefstuk is onderdeel van een serie of collectie"@nl ;
            sh:name "Onderdeel van"@nl ;
            sh:node default1:Rule_isPartOf ;
            sh:path dct:isPartOf ],
        [ sh:name "Titel"@nl ;
            sh:node default1:Rule_title ;
            sh:path dc:title ],
        [ sh:name "Beschrijving"@nl ;
            sh:node default1:Rule_description_dc ;
            sh:path dc:description ],
        [ sh:name "Onderwerp"@nl ;
            sh:node default1:Rule_subject ;
            sh:path dc:subject ],
        [ sh:name "Persoon of organisatie als onderwerp van het werk"@nl ;
            sh:node default1:Rule_about ;
            sh:path schema:about ],
        [ sh:name "Inhoudelijke locatie"@nl ;
            sh:node default1:Rule_contentLocation ;
            sh:path schema:contentLocation ],
        [ sh:name "Maker van het werk"@nl ;
            sh:node default1:Rule_creator ;
            sh:path dc:creator ],
        [ sh:name "Persoon die heeft bijgedragen aan het werk"@nl ;
            sh:node default1:Rule_contributor ;
            sh:path dc:contributor ],
        [ sh:name "Uitgever"@nl ;
            sh:node default1:Rule_publisher ;
            sh:path dc:publisher ],
        [ sh:description "De instelling die het object digitaal beschikbaar stelt."@nl ;
            sh:name "Provider"@nl ;
            sh:node default1:Rule_provider ;
            sh:path schema:provider ],
        [ sh:name "Rechten"@nl ;
            sh:node default1:Rule_rights ;
            sh:path dc:rights ],
        [ sh:name "Bron"@nl ;
            sh:node default1:Rule_source ;
            sh:path dc:source ],
        [ sh:description "De verzameling waar dit object deel van uitmaakt."@nl ;
            sh:name "Collectie"@nl ;
            sh:node default1:Rule_collection ;
            sh:path dcmit:Collection ],
        [ sh:name "Datum"@nl ;
            sh:node default1:Rule_date ;
            sh:path dc:date ],
        [ sh:name "Startdatum"@nl ;
            sh:node default1:Rule_startDate ;
            sh:path schema:startDate ],
        [ sh:name "Einddatum"@nl ;
            sh:node default1:Rule_endDate ;
            sh:path schema:endDate ],
        [ sh:name "Periodisering"@nl ;
            sh:node default1:Rule_temporal ;
            sh:path schema:temporal ] ;
    sh:targetClass schema:Article,
        schema:Book,
        schema:CreativeWork,
        schema:Newspaper,
        schema:Painting,
        schema:Photograph,
        schema:Sculpture,
        schema:SheetMusic,
        schema:VisualArtwork .

schema:ArchiveComponent rdfs:label "Archiefmateriaal"@nl .

skos:Concept rdfs:subClassOf :Webpagina .

default1:Rule_type sh:node default1:Base_IRI ;
    sh:path rdf:type .

schema:CreativeWork rdfs:label "Object"@nl .

default1:Base_Date a sh:PropertyShape ;
    sh:datatype xsd:date .

default1:Base_StringOrIRI a sh:PropertyShape ;
    sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) .

default1:Base_IRI a sh:PropertyShape ;
    sh:nodeKind sh:IRI .

default1:Base_String a sh:PropertyShape ;
    sh:datatype xsd:string .

