@prefix ob: <https://data.oorlogsbronnen.nl/schema#> .
@prefix niod: <https://data.niod.nl/WO2_Thesaurus/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcmit: <http://purl.org/dc/dcmitype/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix picom: <https://personsincontext.org/model/#> .
@prefix pnv: <https://w3id.org/pnv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix wgs: <http://www.w3.org/2003/01/geo/wgs84_pos> .

<https://data.oorlogsbronnen.nl/oorlogsbronnen-shapes> a owl:Ontology ;
    owl:imports <http://datashapes.org/dash> ;
    rdfs:label "Oorlogsbronnen SHACL Shapes"@nl .

# =================================================================
# BASIS LOGICA (Interne herbruikbare blokken)
# =================================================================

ob:Base_String          a sh:PropertyShape ; sh:datatype xsd:string .
ob:Base_IRI             a sh:PropertyShape ; sh:nodeKind sh:IRI .
ob:Base_Date            a sh:PropertyShape ; sh:datatype xsd:date .
ob:Base_Double          a sh:PropertyShape ; sh:datatype xsd:double .
ob:Base_Integer         a sh:PropertyShape ; sh:datatype xsd:integer .
ob:Base_StringOrIRI     a sh:PropertyShape ; sh:or ([sh:datatype xsd:string] [sh:nodeKind sh:IRI]) .
ob:Base_DateOrInteger   a sh:PropertyShape ; sh:or ([sh:datatype xsd:date] [sh:datatype xsd:integer]) .

# =================================================================
# TECHNISCHE BOUWSTENEN (Gekoppeld aan Properties)
# =================================================================

# --- Identificatie en Naamgeving ---
ob:Rule_name               sh:path sdo:name ;           sh:node ob:Base_String ; sh:minCount 1 ; sh:maxCount 1 .
ob:Rule_identifier      sh:path sdo:identifier ;     sh:node ob:Base_String ; sh:minCount 1 ; sh:maxCount 1 .
ob:Rule_deceased           sh:path picom:deceased ;     sh:node ob:Base_String ; sh:maxCount 1 .
ob:Rule_initials           sh:path pnv:initials ;       sh:node ob:Base_String .
ob:Rule_additionalName     sh:path sdo:additionalName ; sh:node ob:Base_String .
ob:Rule_alternateName      sh:path sdo:alternateName ;  sh:node ob:Base_String .
ob:Rule_familyName         sh:path sdo:familyName ;     sh:node ob:Base_String .
ob:Rule_givenName          sh:path sdo:givenName ;      sh:node ob:Base_String .


# --- Beschrijving en Categorisering ---
ob:Rule_material           sh:path sdo:material ;          sh:node ob:Base_String .
ob:Rule_type               sh:path rdf:type ;              sh:node ob:Base_IRI .
ob:Rule_about              sh:path sdo:about ;          sh:node ob:Base_StringOrIRI .
ob:Rule_additionalType     sh:path sdo:additionalType ; sh:node ob:Base_IRI .
ob:Rule_caption            sh:path sdo:caption ;        sh:node ob:Base_String ; sh:maxCount 1 .
ob:Rule_description        sh:path sdo:description ;    sh:node ob:Base_String .
ob:Rule_hasOccupation      sh:path sdo:hasOccupation ;  sh:node ob:Base_String .
ob:Rule_keywords           sh:path sdo:keywords ;       sh:node ob:Base_IRI ; sh:class skos:Concept .
ob:Rule_text               sh:path sdo:text ;           sh:node ob:Base_String .

# --- Data en Tijd ---
ob:Rule_date               sh:path sdo:dateCreated ;   sh:node ob:Base_DateOrInteger ; sh:maxCount 1 .
ob:Rule_created            sh:path dct:created ;       sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_modified           sh:path dct:modified ;      sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_startDate          sh:path sdo:startDate ;     sh:node ob:Base_DateOrInteger ; sh:maxCount 1 .
ob:Rule_endDate            sh:path sdo:endDate ;       sh:node ob:Base_DateOrInteger ; sh:maxCount 1 .
ob:Rule_dateModified       sh:path sdo:dateModified ;  sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_birthDate          sh:path sdo:birthDate ;     sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_deathDate          sh:path sdo:deathDate ;     sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_datePublished      sh:path sdo:datePublished ; sh:node ob:Base_Date ; sh:maxCount 1 .
ob:Rule_temporal           sh:path sdo:temporal ;      sh:node ob:Base_String .

# --- Locatie ---
ob:Rule_address            sh:path sdo:address ;         sh:node ob:Base_StringOrIRI .
ob:Rule_birthPlace         sh:path sdo:birthPlace ;      sh:node ob:Base_StringOrIRI ; sh:maxCount 1 .
ob:Rule_contentLocation    sh:path sdo:contentLocation ; sh:node ob:Base_StringOrIRI .
ob:Rule_deathPlace         sh:path sdo:deathPlace ;      sh:node ob:Base_StringOrIRI ; sh:maxCount 1 .
ob:Rule_fromLocation       sh:path sdo:fromLocation ;    sh:node ob:Base_StringOrIRI .
ob:Rule_homeLocation       sh:path sdo:homeLocation ;    sh:node ob:Base_StringOrIRI .
ob:Rule_lat_schema         sh:path sdo:latitude ;        sh:node ob:Base_String ; sh:maxCount 1 .
ob:Rule_long_schema        sh:path sdo:longitude ;       sh:node ob:Base_String ; sh:maxCount 1 .
ob:Rule_location           sh:path sdo:location ;        sh:node ob:Base_StringOrIRI .
ob:Rule_toLocation         sh:path sdo:toLocation ;      sh:node ob:Base_StringOrIRI .

# --- Personen en Organisaties (Relaties) ---
ob:Rule_creator            sh:path sdo:creator ;      sh:node ob:Base_StringOrIRI .
ob:Rule_contributor        sh:path sdo:contributor ;  sh:node ob:Base_StringOrIRI .
ob:Rule_publisher          sh:path sdo:publisher ;    sh:node ob:Base_IRI  ; sh:class sdo:Organization .
ob:Rule_actor              sh:path sdo:actor ;        sh:node ob:Base_IRI ; sh:or ([ sh:class picom:PersonReconstruction ] [ sh:class picom:PersonObservation ]) .
ob:Rule_children           sh:path sdo:children;      sh:node ob:Base_IRI ;  sh:or ([ sh:class picom:PersonReconstruction ] [ sh:class picom:PersonObservation ]) .
ob:Rule_gender             sh:path sdo:gender ;       sh:node ob:Base_StringOrIRI .
ob:Rule_parent             sh:path sdo:parent ;       sh:node ob:Base_IRI ;  sh:or ([ sh:class picom:PersonReconstruction ] [ sh:class picom:PersonObservation ]) .
ob:Rule_provider           sh:path sdo:provider ;     sh:node ob:Base_StringOrIRI .
ob:Rule_sibling            sh:path sdo:sibling ;      sh:node ob:Base_IRI ;  sh:or ([ sh:class picom:PersonReconstruction ] [ sh:class picom:PersonObservation ]) .

# --- Media en Web ---
ob:Rule_contentUrl         sh:path sdo:contentUrl ;   sh:node ob:Base_StringOrIRI .
ob:Rule_image              sh:path sdo:image ;        sh:node ob:Base_IRI .
ob:Rule_thumbnail          sh:path sdo:thumbnail ;    sh:node ob:Base_StringOrIRI .
ob:Rule_thumbnailUrl       sh:path sdo:thumbnailUrl ; sh:node ob:Base_StringOrIRI .
ob:Rule_url                sh:path sdo:url ;          sh:node ob:Base_StringOrIRI .

# --- Structureel en Rechten ---
ob:Rule_isPartOf           sh:path sdo:isPartOf ;   sh:node ob:Base_StringOrIRI  .
ob:Rule_license            sh:path sdo:license ;    sh:node ob:Base_IRI ; sh:class ob:Rights .
ob:Rule_position           sh:path sdo:position ;   sh:node ob:Base_Integer .
ob:Rule_superEvent         sh:path sdo:superEvent ; sh:node ob:Base_IRI ; sh:class sdo:Event .

# --- Herkomst en Verwijzingen ---
ob:Rule_inDataset          sh:path ob:inDataset ;        sh:node ob:Base_IRI ; sh:class sdo:Dataset .
ob:Rule_hadPrimarySource   sh:path prov:hadPrimarySource ; sh:node ob:Base_IRI ; sh:or ([ sh:class prov:Entity ] [ sh:class sdo:ArchiveComponent ]) .
ob:Rule_wasDerivedFrom     sh:path prov:wasDerivedFrom ;   sh:node ob:Base_IRI ; sh:class picom:PersonObservation .
ob:Rule_sameAs             sh:path sdo:sameAs ;         sh:node ob:Base_IRI .

# --- SKOS thesaurus attributen ---
ob:Rule_prefLabel          sh:path skos:prefLabel ;   sh:node ob:Base_String ; sh:minCount 1 .
ob:Rule_altLabel           sh:path skos:altLabel ;    sh:node ob:Base_String .
ob:Rule_hiddenLabel        sh:path skos:hiddenLabel ; sh:node ob:Base_String .
ob:Rule_definition         sh:path skos:definition ;  sh:node ob:Base_String .
ob:Rule_scopeNote          sh:path skos:scopeNote ;   sh:node ob:Base_String .

ob:Rule_inScheme           sh:path skos:inScheme ; sh:node ob:Base_IRI ; sh:class skos:ConceptScheme ; sh:minCount 1 .
ob:Rule_broader            sh:path skos:broader ;  sh:node ob:Base_IRI ; sh:class skos:Concept .
ob:Rule_narrower           sh:path skos:narrower ; sh:node ob:Base_IRI ; sh:class skos:Concept .
ob:Rule_related            sh:path skos:related ;  sh:node ob:Base_IRI ; sh:class skos:Concept .

ob:Rule_exactMatch         sh:path skos:exactMatch ; sh:node ob:Base_IRI .
ob:Rule_closeMatch         sh:path skos:closeMatch ; sh:node ob:Base_IRI .

ob:Rule_wgsLocation        sh:path wgs:location ; sh:node ob:Base_IRI ; sh:or ([ sh:class skos:Concept ] [ sh:class wgs:SpatialTing ]) .
ob:Rule_lat                sh:path wgs:lat ;      sh:node ob:Base_Double ; sh:maxCount 1 .
ob:Rule_long               sh:path wgs:long ;     sh:node ob:Base_Double ; sh:maxCount 1 .

# =================================================================
# 2. TOEPASSING OP KLASSEN (Context-specifieke labels voor Widoco)
# =================================================================

### --- PERSOONSRECONSTRUCTIEs ---
ob:PersoonReconstructionShape a sh:NodeShape ;
    sh:targetClass picom:PersonReconstruction ;
    sh:name "Persoonsreconstructies"@nl ;
    sh:description "De geaggregeerde en gevalideerde gegevens van een persoon, samengesteld uit één of meerdere persoonsvermeldingen."@nl ;

    # --- Identificatie ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:description "De unieke identifier van persoon."@nl ;
        sh:node ob:Rule_identifier ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Type entiteit"@nl ;
        sh:description "Classificatie van de entiteit volgens Persons in Context."@nl ;
        sh:node ob:Rule_type ;
    ] ;

    # --- Naamgeving ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam"@nl ;
        sh:description "De gestandaardiseerde volledige naam van de persoon."@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:alternateName ;
        sh:name "Andere namen"@nl ;
        sh:description "Varianten, aliassen of historische schrijfwijzen van de naam."@nl ;
        sh:node ob:Rule_alternateName ;
    ] ;

    # --- Levensloop en Status ---
    sh:property [
        sh:path sdo:birthDate ;
        sh:name "Geboortedatum"@nl ;
        sh:node ob:Rule_birthDate ;
    ] ;
    sh:property [
        sh:path sdo:birthPlace ;
        sh:name "Geboorteplaats"@nl ;
        sh:node ob:Rule_birthPlace ;
    ] ;
    sh:property [
        sh:path sdo:deathDate ;
        sh:name "Datum van overlijden"@nl ;
        sh:node ob:Rule_deathDate ;
    ] ;
    sh:property [
        sh:path sdo:deathPlace ;
        sh:name "Plaats van overlijden"@nl ;
        sh:node ob:Rule_deathPlace ;
    ] ;
    sh:property [
        sh:path picom:deceased ;
        sh:name "Overleden status"@nl ;
        sh:description "Indicatie of de persoon is overleden."@nl ;
        sh:node ob:Rule_deceased ;
    ] ;
    sh:property [
        sh:path sdo:gender ;
        sh:name "Geslacht"@nl ;
        sh:node ob:Rule_gender ;
    ] ;

    # --- Familierelaties ---
    sh:property [
        sh:path sdo:children ;
        sh:name "Kinderen"@nl ;
        sh:description "Verwijzing naar de kinderen van deze persoon."@nl ;
        sh:node ob:Rule_children ;
    ] ;
    sh:property [
        sh:path sdo:parent ;
        sh:name "Ouder"@nl ;
        sh:description "Verwijzing naar een ouder van deze persoon."@nl ;
        sh:node ob:Rule_parent ;
    ] ;
    sh:property [
        sh:path sdo:sibling ;
        sh:name "Broer of zus"@nl ;
        sh:description "Verwijzing naar een broer of zus van deze persoon."@nl ;
        sh:node ob:Rule_sibling ;
    ] ;

    # --- Metadata en Herkomst ---
    sh:property [
        sh:path sdo:dateCreated ;
        sh:name "Aanmaakdatum"@nl ;
        sh:description "Datum waarop deze reconstructie voor het eerst is aangemaakt."@nl ;
        sh:node ob:Rule_dateCreated ;
    ] ;
    sh:property [
        sh:path sdo:dateModified ;
        sh:name "Wijzigingsdatum"@nl ;
        sh:description "Datum waarop deze reconstructie voor het laatst is bijgewerkt."@nl ;
        sh:node ob:Rule_dateModified ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:name "Afgeleid van"@nl ;
        sh:description "Verwijzing naar de persoonsvermeldingen waaruit deze reconstructie is opgebouwd."@nl ;
        sh:node ob:Rule_wasDerivedFrom ;
    ] ;
    sh:property [
        sh:path sdo:sameAs ;
        sh:name "Andere autoriteit"@nl ;
        sh:description "Externe links naar dezelfde persoon in andere systemen (bijv. Wikidata)."@nl ;
        sh:node ob:Rule_sameAs ;
    ] ;
    sh:property [
        sh:path sdo:keywords ;
        sh:name "Trefwoorden"@nl ;
        sh:description "Categorisering of trefwoorden van toepassing op de persoon (uit de WO2 thesaurus)."@nl ;
        sh:node ob:Rule_keywords ;
    ] .

### --- PERSOONSVERMELDING ---
ob:PersoonsvermeldingShape a sh:NodeShape ;
    sh:targetClass picom:PersonObservation ;
    sh:name "Persoonsvermeldingen"@nl ;
    sh:description "Een observatie of vermelding van een persoon binnen een specifieke historische bron."@nl ;

    # 1. Hergebruik alle regels van PersonReconstruction
    sh:node ob:PersoonReconstructionShape ;

    # 2. Sluit specifiek uit
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:maxCount 0 ;
        sh:name "Afgeleid van (niet toegestaan)"@nl ;
        sh:description "Voor persoonsvermeldingen wordt prov:wasDerivedFrom niet toegestaan."@nl ;
    ] ;

    # 3. Voeg extra properties toe
    # --- Naamgeving ---
    sh:property [
        sh:path sdo:givenName ;
        sh:name "Voornaam"@nl ;
        sh:description "De roepnaam of eerste voornaam van de persoon."@nl ;
        sh:node ob:Rule_givenName ;
    ] ;
    sh:property [
        sh:path sdo:familyName ;
        sh:name "Achternaam"@nl ;
        sh:description "De geslachtsnaam, inclusief tussenvoegsels."@nl ;
        sh:node ob:Rule_familyName ;
    ] ;
    sh:property [
        sh:path pnv:initials ;
        sh:name "Initialen"@nl ;
        sh:description "De voorletters van de persoon."@nl ;
        sh:node ob:Rule_initials ;
    ] ;

    # --- Kenmerken en Context ---
    sh:property [
        sh:path sdo:hasOccupation ;
        sh:name "Beroep of functie"@nl ;
        sh:description "Het beroep of de maatschappelijke rol van de persoon."@nl ;
        sh:node ob:Rule_hasOccupation ;
    ] ;
    sh:property [
        sh:path sdo:address ;
        sh:name "Adresgegevens"@nl ;
        sh:description "Woonplaats of laatst bekende adres."@nl ;
        sh:node ob:Rule_address ;
    ] ;
    sh:property [
        sh:path prov:hadPrimarySource ;
        sh:name "Primaire bron"@nl ;
        sh:description "De originele bron waaruit deze informatie afkomstig is."@nl ;
        sh:node ob:Rule_hadPrimarySource ;
    ] ;
    sh:property [
        sh:path sdo:description ;
        sh:name "Biografische schets"@nl ;
        sh:description "Een korte beschrijving van de persoon of diens rol tijdens de Tweede Wereldoorlog."@nl ;
        sh:node ob:Rule_description ;
    ] .

### --- GEBEURTENISSEN BIJ PERSONEN ---
ob:EventShape a sh:NodeShape ;
    sh:targetClass sdo:Event ;
    sh:name "Gebeurtenissen"@nl ;
    sh:description ""@nl ;

    # --- Type ---
    sh:property [
        sh:path rdf:type ;
        sh:name "Type entiteit"@nl ;
        sh:description "Classificatie van de entiteit als sdo:Event"@nl ;
        sh:node ob:Rule_type ;
    ] ;
    sh:property [
        sh:path sdo:additionalType ;
        sh:name "type gebeurtenis"@nl ;
        sh:description "Classificatie van de gebeurtenis als persoonlijke gebeurtenis uit de WO2 thesaurus"@nl ;
        sh:node ob:Rule_additionalType ;
    ] ;

    # --- Kenmerken en Context ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam"@nl ;
        sh:description "De naam van de gebeurtenis."@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:location ;
        sh:name "Locatie"@nl ;
        sh:node ob:Rule_location ;
    ] ;
    sh:property [
        sh:path sdo:fromLocation ;
        sh:name "Beginlocatie"@nl ;
        sh:node ob:Rule_fromLocation ;
    ] ;
    sh:property [
        sh:path sdo:toLocation ;
        sh:name "Eindlocatie"@nl ;
        sh:node ob:Rule_toLocation ;
    ] ;
    sh:property [
        sh:path sdo:actor ;
        sh:name "Persoon in de gebeurtenis"@nl ;
        sh:node ob:Rule_actor ;
    ] ;
    sh:property [
        sh:path sdo:superEvent ;
        sh:name "Grotere gebeurtenis"@nl ;
        sh:node ob:Rule_superEvent ;
    ] ;
    sh:property [
        sh:path prov:hadPrimarySource ;
        sh:name "Primaire bron"@nl ;
        sh:description "De originele bron waaruit deze informatie afkomstig is."@nl ;
        sh:node ob:Rule_hadPrimarySource ;
    ] ;

    # --- Tijd ---
    sh:property [
        sh:path sdo:startDate ;
        sh:name "Startdatum"@nl ;
        sh:node ob:Rule_startDate ;
    ] ;
    sh:property [
        sh:path sdo:endDate ;
        sh:name "Einddatum"@nl ;
        sh:node ob:Rule_endDate ;
    ] .

### --- BRONNEN VOOR PERSONEN ---

## --- BRON ---
ob:SourceShape a sh:NodeShape ;
    sh:targetClass 
        sdo:ArchiveComponent,
        prov:Entity ;
    sh:name "Archiefrecords (personen)"@nl ;
    sh:description "Archiefstukken, maar ook records uit andere (onderzoeks)datasets en webpagina's kunnen persoonsvermeldingen bevatten. Dit is hiervoor de bronvermelding."@nl ;
    
    sh:property [
        sh:path rdf:type ;
        sh:name "Type entiteit"@nl ;
        sh:description "Classificatie van het record als archiefstuk of anders."@nl ;
        sh:node ob:Rule_type ;
    ] ;
    sh:property [
        sh:path sdo:url ;
        sh:name "Url van de bron"@nl ;
        sh:node ob:Rule_url ;
    ] ;
    sh:property [
        sh:path niod:inDataset ;
        sh:name "Herkomst van het record"@nl ;
        sh:node ob:Rule_inDataset ;
    ] .

## --- DATASET ---
ob:DatasetShape a sh:NodeShape ;
    sh:targetClass 
        sdo:Dataset ;
    sh:name "Datasets"@nl ;
    sh:description "Records  maken altijd onderdeel uit van een dataset."@nl ;
    
    # --- Identificatie ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:description "De unieke identifier van de dataset."@nl ;
        sh:node ob:Rule_identifier ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Type entiteit"@nl ;
        sh:description "Classificatie van de entiteit als sdo:Dataset"@nl ;
        sh:node ob:Rule_type ;
    ] ;

    # --- Kenmerken en context ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam van de dataset"@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:description ;
        sh:name "Beschrijving van de dataset"@nl ;
        sh:node ob:Rule_description ;
    ] ;
    sh:property [
        sh:path sdo:url ;
        sh:name "Bronverwijzing voor de dataset"@nl ;
        sh:node ob:Rule_url ;
    ] ;
    sh:property [
        sh:path sdo:provider ;
        sh:name "Leverancier van de dataset"@nl ;
        sh:node ob:Rule_provider ;
    ] .

### --- KUNSTWERKEN, BRONNEN EN ANDERE OBJECT TYPEN ---
ob:CreativeWorkShape a sh:NodeShape ;
    sh:targetClass 
        sdo:CreativeWork,
        sdo:Article, 
        sdo:Newspaper, 
        sdo:Book, 
        sdo:Photograph, 
        sdo:VisualArtwork, 
        sdo:Painting, 
        sdo:Sculpture, 
        sdo:SheetMusic ;
    sh:name "Creatieve werken"@nl ;
    sh:description "Verschillende typen bronnen en objecten die binnen de collectie worden beschreven, zoals artikelen, foto's en kunstwerken."@nl ;
    
    # --- Identificatie en Basis ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:node ob:Rule_identifier ;
    ] ;
    sh:property [
        sh:path rdf:type ;
        sh:name "Type (RDF)"@nl ;
        sh:node ob:Rule_type ;
    ] ;
    sh:property [
        sh:path sdo:additionalType ;
        sh:name "Type"@nl ;
        sh:node ob:Rule_additionalType ;
    ] ;
    sh:property [
        sh:path sdo:material ;
        sh:name "Materiaal"@nl ;
        sh:node ob:Rule_material ;
    ] ;
    sh:property [
        sh:path sdo:isPartOf ;
        sh:name "Onderdeel van"@nl ;
        sh:description "Dit object of archiefstuk is onderdeel van een serie of collectie"@nl ;
        sh:node ob:Rule_isPartOf ;
    ] ;

    # --- Inhoud en Onderwerp ---
        sh:property [
        sh:path sdo:name ;
        sh:name "Titel"@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:description ;
        sh:name "Beschrijving"@nl ;
        sh:node ob:Rule_description ;
    ] ;
    sh:property [
        sh:path sdo:keywords ;
        sh:name "Onderwerp"@nl ;
        sh:node ob:Rule_keywords ;
    ] ;
    sh:property [
        sh:path sdo:about ;
        sh:name "Persoon of organisatie als onderwerp van het werk"@nl ;
        sh:node ob:Rule_about ;
    ] ;
    sh:property [
        sh:path sdo:contentLocation ;
        sh:name "Inhoudelijke locatie"@nl ;
        sh:node ob:Rule_contentLocation ;
    ] ;

    # --- Creatie en Herkomst ---
    sh:property [
        sh:path sdo:creator ;
        sh:name "Maker van het werk"@nl ;
        sh:node ob:Rule_creator ;
    ] ;
    sh:property [
        sh:path sdo:contributor ;
        sh:name "Persoon die heeft bijgedragen aan het werk"@nl ;
        sh:node ob:Rule_contributor ;
    ] ;
    sh:property [
        sh:path sdo:publisher ;
        sh:name "Uitgever"@nl ;
        sh:node ob:Rule_publisher ;
    ] ;
    sh:property [
        sh:path sdo:provider ;
        sh:name "Provider"@nl ;
        sh:description "De instelling die het object digitaal beschikbaar stelt."@nl ;
        sh:node ob:Rule_provider ;
    ] ;
    sh:property [
        sh:path sdo:license ;
        sh:name "Rechten"@nl ;
        sh:node ob:Rule_license ;
    ] ;
    sh:property [
        sh:path sdo:url ;
        sh:name "Bron"@nl ;
        sh:node ob:Rule_url ;
    ] ;
    sh:property [
        sh:path sdo:isPartOf ;
        sh:name "Collectie"@nl ;
        sh:description "De verzameling waar dit object deel van uitmaakt."@nl ;
        sh:node ob:Rule_isPartOf ;
    ] ;

    # --- Tijd ---
    sh:property [
        sh:path sdo:dateCreated ;
        sh:name "Datum"@nl ;
        sh:node ob:Rule_date ;
    ] ;
    sh:property [
        sh:path sdo:startDate ;
        sh:name "Startdatum"@nl ;
        sh:node ob:Rule_startDate ;
    ] ;
    sh:property [
        sh:path sdo:endDate ;
        sh:name "Einddatum"@nl ;
        sh:node ob:Rule_endDate ;
    ] ;
        sh:property [
        sh:path sdo:temporal ;
        sh:name "Periodisering"@nl ;
        sh:node ob:Rule_temporal ;
    ] ;

    # --- Visueel ---
    sh:property [
        sh:path sdo:thumbnail ;
        sh:name "Thumbnail"@nl ;
        sh:node ob:Rule_thumbnail ;
    ] .

### --- ARCHIEVEN EN ARCHIEFSTUKKEN (Uitbreiding op CreativeWorkShape) ---
ob:ArchiveShape a sh:NodeShape ;
    sh:targetClass 
        ob:Archive,
        ob:ArchiveFile ;
    sh:name "Archieven"@nl ;

    # 1. Hergebruik alle regels van CreativeWork
    sh:node ob:CreativeWorkShape .

    # 2. Voeg extra properties toe (niet meer aan de orde)

### --- AUDIO EN VIDEO OBJECTEN (Uitbreiding  op CreativeWorkShape) ---
ob:MediaShape a sh:NodeShape ;
    sh:targetClass 
        sdo:VideoObject,
        sdo:AudioObject ;
    sh:name "Media objecten"@nl ;
    
    # 1. Hergebruik alle regels van CreativeWork
    sh:node ob:CreativeWorkShape ;

    # 2. Voeg extra properties toe
    sh:property [
        sh:path sdo:contentUrl ;
        sh:name "Url van het media object"@nl ;
        sh:node ob:Rule_contentUrl ;
    ] .

### --- MONUMENTEN (Uitbreiding  op CreativeWorkShape) ---
ob:MonumentShape a sh:NodeShape ;
    sh:targetClass niod:Monument ;
    sh:name "Monumenten"@nl ;
    
    # 1. Hergebruik alle regels van CreativeWork
    sh:node ob:CreativeWorkShape ;

    # 2. Voeg extra properties toe
    sh:property [
        sh:path sdo:latitude ;
        sh:name "Latitude"@nl ;
        sh:description "Breedtegraad van de locatie van het monument."@nl ;
        sh:node ob:Rule_lat_schema ;
    ] ;
    sh:property [
        sh:path sdo:longitude ;
        sh:name "Longitude"@nl ;
        sh:description "Lengtegraad van de locatie van het monument"@nl ;
        sh:node ob:Rule_long_schema ;
    ] .

### --- BEKENDMAKINGEN (Uitbreiding  op CreativeWorkShape) ---
ob:BekendmakingShape a sh:NodeShape ;
    sh:targetClass ob:Bekendmaking ;
    sh:name "Bekendmakingen"@nl ;
    
    # 1. Hergebruik alle regels van CreativeWork
    sh:node ob:CreativeWorkShape ;

    # 2. Voeg extra properties toe
    sh:property [
        sh:path sdo:text ;
        sh:name "Tekst"@nl ;
        sh:description "Transcriptie van de tekst op het document"@nl ;
        sh:node ob:Rule_text ;
    ] ;
    sh:property [
        sh:path sdo:datePublished ;
        sh:name "Publicatiedatum"@nl ;
        sh:description "Publicatiedatum van het document"@nl ;
        sh:node ob:Rule_datePublished ;
    ] .

### --- THESAURUSCONCEPTEN ---
ob:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:name "Thesaurusconcepten"@nl ;
    sh:description "Een abstract idee of een term uit een gecontroleerde woordenlijst of thesaurus."@nl ;

    # --- Identificatie en Basis ---
    sh:property [
        sh:path rdf:type ;
        sh:name "Type (RDF)"@nl ;
        sh:node ob:Rule_type ;
    ] ;

    # --- Inhoud en Onderwerp ---
    sh:property [
        sh:path skos:prefLabel ;
        sh:name "Voorkeursterm"@nl ;
        sh:description "De officiële naam van het concept in de thesaurus."@nl ;
        sh:node ob:Rule_prefLabel ;
    ] ;

    sh:property [
        sh:path skos:altLabel ;
        sh:name "Alternatieve term"@nl ;
        sh:description "Synoniemen of andere schrijfwijzen van het concept."@nl ;
        sh:node ob:Rule_altLabel ;
    ] ;

        sh:property [
        sh:path skos:hiddenLabel ;
        sh:name "Verborgen term"@nl ;
        sh:description "Termen zoals spelfouten die wel doorzoekbaar moeten zijn, maar niet getoond worden."@nl ;
        sh:node ob:Rule_hiddenLabel ;
    ] ;

        sh:property [
        sh:path skos:scopeNote ;
        sh:name "Beschrijving"@nl ;
        sh:description "Een tekstuele beschrijving van het concept."@nl ;
        sh:node ob:Rule_scopeNote ;
    ] ;

    sh:property [
        sh:path skos:definition ;
        sh:name "Definitie"@nl ;
        sh:description "Een tekstuele uitleg van de betekenis van het concept."@nl ;
        sh:node ob:Rule_definition ;
    ] ;

    # --- Relaties met andere concepten ---
    sh:property [
        sh:path skos:inScheme ;
        sh:name "Behoort tot thesaurus"@nl ;
        sh:description "De overkoepelende thesaurus of conceptenlijst waar dit concept deel van uitmaakt."@nl ;
        sh:node ob:Rule_inScheme ;
    ] ;

    sh:property [
        sh:path skos:broader ;
        sh:name "Breder concept"@nl ;
        sh:description "Verwijzing naar een concept dat hoger in de hiërarchie staat."@nl ;
        sh:node ob:Rule_broader ;
    ] ;

    sh:property [
        sh:path skos:narrower ;
        sh:name "Kleiner concept"@nl ;
        sh:description "Verwijzing naar een concept dat lager in de hiërarchie staat."@nl ;
        sh:node ob:Rule_narrower ;
    ] ;

    sh:property [
        sh:path skos:related ;
        sh:name "Gerelateerd concept"@nl ;
        sh:description "Verwijzing naar een concept dat inhoudelijk verwant is, maar niet in de hiërarchie staat."@nl ;
        sh:node ob:Rule_related ;
    ] ;

    sh:property [
        sh:path skos:exactMatch ;
        sh:name "Exacte match"@nl ;
        sh:description "Verwijzing naar een identiek concept in een externe bron (bijv. AAT of WO2-thesaurus)."@nl ;
        sh:node ob:Rule_exactMatch ;
    ] ;

    # --- Locatie ---
    sh:property [
        sh:path wgs:location ;
        sh:name "Locatie"@nl ;
        sh:description "Locatie van het concept."@nl ;
        sh:node ob:Rule_wgsLocation ;
    ] ;

    sh:property [
        sh:path wgs:lat ;
        sh:name "Latitude"@nl ;
        sh:description "Breedtegraad van de locatie van het concept."@nl ;
        sh:node ob:Rule_lat ;
    ] ;
    
    sh:property [
        sh:path wgs:long ;
        sh:name "Longitude"@nl ;
        sh:description "Lengtegraad van de locatie van het concept."@nl ;
        sh:node ob:Rule_long ;
    ] ;

    # --- Tijd ---
    sh:property [
        sh:path dct:created ;
        sh:name "Aanmaakdatum"@nl ;
        sh:node ob:Rule_created ;
    ] ;

    sh:property [
        sh:path dct:modified ;
        sh:name "Wijzigingsdatum"@nl ;
        sh:node ob:Rule_modified ;
    ] ;

    sh:property [
        sh:path sdo:startDate ;
        sh:name "Startdatum"@nl ;
        sh:node ob:Rule_startDate ;
    ] ;
    sh:property [
        sh:path sdo:endDate ;
        sh:name "Einddatum"@nl ;
        sh:node ob:Rule_endDate ;
    ] .
