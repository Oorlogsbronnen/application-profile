@prefix ob: <https://data.oorlogsbronnen.nl/schema#> .
@prefix niod: <https://data.niod.nl/WO2_Thesaurus/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcmit: <http://purl.org/dc/dcmitype/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix picom: <https://personsincontext.org/model/#> .
@prefix pnv: <https://w3id.org/pnv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix wgs: <http://www.w3.org/2003/01/geo/wgs84_pos> .

# Shapes van de kennisgraaf personen (LDmax-dataset wo2net/personen).
# Valideren en gebruiken samen met shapes-bouwstenen.ttl.

### --- PERSOONSRECONSTRUCTIES ---
ob:PersoonsReconstructieShape a sh:NodeShape ;
    sh:targetClass picom:PersonReconstruction ;
    sh:name "Persoonsreconstructies"@nl ;
    sh:description "Persoonsreconstructies zijn samengesteld uit één of meerdere door WO2Net geaggregeerde persoonsvermeldingen."@nl ;

    # --- Identificatie ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:description "De unieke identifier (PID) van de persoonsreconstructie."@nl ;
        sh:node ob:Rule_identifier ;
    ] ;

    # --- Naamgeving ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam"@nl ;
        sh:description "De gestandaardiseerde volledige naam van de persoon."@nl ;
        sh:node ob:Rule_name_rec ;
    ] ;
    sh:property [
        sh:path sdo:alternateName ;
        sh:name "Andere namen"@nl ;
        sh:description "Varianten of historische schrijfwijzen van de naam. Ook gebruikt voor aliassen en bijnamen."@nl ;
        sh:node ob:Rule_alternateName ;
    ] ;

    # --- Levensloop en Status ---
    sh:property [
        sh:path sdo:birthDate ;
        sh:name "Geboortedatum"@nl ;
        sh:node ob:Rule_birthDate ;
    ] ;
    sh:property [
        sh:path sdo:birthPlace ;
        sh:name "Geboorteplaats"@nl ;
        sh:node ob:Rule_birthPlace ;
    ] ;
    sh:property [
        sh:path sdo:deathDate ;
        sh:name "Datum van overlijden"@nl ;
        sh:node ob:Rule_deathDate ;
    ] ;
    sh:property [
        sh:path sdo:deathPlace ;
        sh:name "Plaats van overlijden"@nl ;
        sh:node ob:Rule_deathPlace ;
    ] ;
    sh:property [
        sh:path picom:deceased ;
        sh:name "Overleden status"@nl ;
        sh:description "Indicatie of de persoon is overleden."@nl ;
        sh:node ob:Rule_deceased ;
    ] ;
    sh:property [
        sh:path sdo:gender ;
        sh:name "Geslacht"@nl ;
        sh:node ob:Rule_gender_rec ;
    ] ;

    # --- Familierelaties ---
    sh:property [
        sh:path sdo:children ;
        sh:name "Kinderen"@nl ;
        sh:description "Verwijzing naar de kinderen van de persoon."@nl ;
        sh:node ob:Rule_children_rec ;
    ] ;
    sh:property [
        sh:path sdo:parent ;
        sh:name "Ouder"@nl ;
        sh:description "Verwijzing naar een ouder van de persoon."@nl ;
        sh:node ob:Rule_parent_rec ;
    ] ;
    sh:property [
        sh:path sdo:sibling ;
        sh:name "Broer of zus"@nl ;
        sh:description "Verwijzing naar een broer of zus van de persoon."@nl ;
        sh:node ob:Rule_sibling_rec ;
    ] ;
    sh:property [
        sh:path sdo:spouse ;
        sh:name "Partner"@nl ;
        sh:description "Verwijzing naar de (huwelijks)partner van de persoon."@nl ;
        sh:node ob:Rule_spouse_rec ;
    ] ;

    # --- Metadata en Herkomst ---
    sh:property [
        sh:path sdo:dateCreated ;
        sh:name "Aanmaakdatum"@nl ;
        sh:description "Datum waarop de persoonsreconstructie voor het eerst is aangemaakt."@nl ;
        sh:node ob:Rule_dateCreated ;
    ] ;
    sh:property [
        sh:path sdo:dateModified ;
        sh:name "Wijzigingsdatum"@nl ;
        sh:description "Datum waarop de persoonsreconstructie voor het laatst is bijgewerkt."@nl ;
        sh:node ob:Rule_dateModified ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:name "Afgeleid van"@nl ;
        sh:description "Verwijzing naar de persoonsvermeldingen waaruit de reconstructie is opgebouwd."@nl ;
        sh:node ob:Rule_wasDerivedFrom ;
    ] ;
    sh:property [
        sh:path sdo:sameAs ;
        sh:name "Andere autoriteit"@nl ;
        sh:description "Externe links naar dezelfde persoon in andere systemen (bijv. Wikipedia)."@nl ;
        sh:node ob:Rule_sameAs ;
    ] ;
    sh:property [
        sh:path sdo:keywords ;
        sh:name "Trefwoorden"@nl ;
        sh:description "Categorisering of trefwoorden van toepassing op de persoon (uit de WO2 thesaurus)."@nl ;
        sh:node ob:Rule_keywords_person ;
    ] .

### --- PERSOONSVERMELDINGEN ---
ob:PersoonsvermeldingShape a sh:NodeShape ;
    sh:targetClass picom:PersonObservation ;
    sh:name "Persoonsvermeldingen"@nl ;
    sh:description "Vermeldingen van personen binnen een specifieke historische bron."@nl ;
    
    # --- Identificatie ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:description "De interne identifier van de persoonsvermelding."@nl ;
        sh:node ob:Rule_identifier ;
    ] ;

    # --- Naamgeving ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam"@nl ;
        sh:description "De volledige naam van de persoon."@nl ;
        sh:node ob:Rule_name_rec ;
    ] ;
    sh:property [
        sh:path sdo:alternateName ;
        sh:name "Andere namen"@nl ;
        sh:description "Varianten of historische schrijfwijzen van de naam. Ook gebruikt voor aliassen en bijnamen."@nl ;
        sh:node ob:Rule_alternateName ;
    ] ;
    sh:property [
        sh:path sdo:givenName ;
        sh:name "Voornaam"@nl ;
        sh:description "De voorna(a)m(en) of roepnaam van de persoon."@nl ;
        sh:node ob:Rule_givenName ;
    ] ;
    sh:property [
        sh:path sdo:familyName ;
        sh:name "Achternaam"@nl ;
        sh:description "De achternaam of familienaam, inclusief tussenvoegsels."@nl ;
        sh:node ob:Rule_familyName ;
    ] ;
    sh:property [
        sh:path pnv:initials ;
        sh:name "Initialen"@nl ;
        sh:description "De initialen (voorletters) van de persoon."@nl ;
        sh:node ob:Rule_initials ;
    ] ;

    # --- Levensloop en Status ---
    sh:property [
        sh:path sdo:birthDate ;
        sh:name "Geboortedatum"@nl ;
        sh:node ob:Rule_birthDate ;
    ] ;
    sh:property [
        sh:path sdo:birthPlace ;
        sh:name "Geboorteplaats"@nl ;
        sh:node ob:Rule_birthPlace ;
    ] ;
    sh:property [
        sh:path sdo:deathDate ;
        sh:name "Datum van overlijden"@nl ;
        sh:node ob:Rule_deathDate ;
    ] ;
    sh:property [
        sh:path sdo:deathPlace ;
        sh:name "Plaats van overlijden"@nl ;
        sh:node ob:Rule_deathPlace ;
    ] ;
    sh:property [
        sh:path picom:deceased ;
        sh:name "Overleden status"@nl ;
        sh:description "Indicatie of de persoon is overleden."@nl ;
        sh:node ob:Rule_deceased ;
    ] ;
    sh:property [
        sh:path sdo:gender ;
        sh:name "Geslacht"@nl ;
        sh:node ob:Rule_gender_rec ;
    ] ;

    # --- Familierelaties ---
    sh:property [
        sh:path sdo:children ;
        sh:name "Kinderen"@nl ;
        sh:description "Verwijzing naar de kinderen van de persoon."@nl ;
        sh:node ob:Rule_children ;
    ] ;
    sh:property [
        sh:path sdo:parent ;
        sh:name "Ouder"@nl ;
        sh:description "Verwijzing naar een ouder van de persoon."@nl ;
        sh:node ob:Rule_parent ;
    ] ;
    sh:property [
        sh:path sdo:sibling ;
        sh:name "Broer of zus"@nl ;
        sh:description "Verwijzing naar een broer of zus van de persoon."@nl ;
        sh:node ob:Rule_sibling ;
    ] ;
    sh:property [
        sh:path sdo:spouse ;
        sh:name "Partner"@nl ;
        sh:description "Verwijzing naar de (huwelijks)partner van de persoon."@nl ;
        sh:node ob:Rule_spouse ;
    ] ;

    # --- Kenmerken en Context ---
    sh:property [
        sh:path sdo:keywords ;
        sh:name "Trefwoorden"@nl ;
        sh:description "Categorisering of trefwoorden van toepassing op de persoon (uit de WO2 thesaurus)."@nl ;
        sh:node ob:Rule_keywords_person ;
    ] ;

    sh:property [
        sh:path sdo:hasOccupation ;
        sh:name "Beroep of functie"@nl ;
        sh:description "Het beroep of de maatschappelijke rol van de persoon tijdens de Tweede Wereldoorlog."@nl ;
        sh:node ob:Rule_hasOccupation ;
    ] ;
    sh:property [
        sh:path sdo:address ;
        sh:name "Adresgegevens"@nl ;
        sh:description "Woonplaats of laatst bekende adres."@nl ;
        sh:node ob:Rule_address ;
    ] ;
    sh:property [
        sh:path prov:hadPrimarySource ;
        sh:name "Bronvermelding"@nl ;
        sh:description "Verwijzing naar de bron waaruit de persoonsvermelding is afgeleid."@nl ;
        sh:node ob:Rule_hadPrimarySource ;
    ] ;
    sh:property [
        sh:path sdo:description ;
        sh:name "Biografie"@nl ;
        sh:description "Een korte beschrijving van de persoon of diens rol tijdens de Tweede Wereldoorlog."@nl ;
        sh:node ob:Rule_description ;
    ] .

### --- GEBEURTENISSEN BIJ PERSONEN ---
ob:EventShape a sh:NodeShape ;
    sh:targetClass sdo:Event ;
    sh:name "Gebeurtenissen"@nl ;
    sh:description "Belangrijke gebeurtenissen in het leven van de persoon (tijdens de Tweede Wereldoorlog)"@nl ;

    sh:property [
        sh:path sdo:additionalType ;
        sh:name "type gebeurtenis"@nl ;
        sh:description "Classificatie van de gebeurtenis als persoonlijke gebeurtenis uit de WO2 thesaurus"@nl ;
        sh:node ob:Rule_additionalType_events ;
    ] ;

    # --- Kenmerken en Context ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam"@nl ;
        sh:description "Naam van de gebeurtenis."@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:location ;
        sh:name "Locatie van de gebeurtenis"@nl ;
        sh:node ob:Rule_location ;
    ] ;
    sh:property [
        sh:path sdo:fromLocation ;
        sh:name "Beginlocatie van de gebeurtenis"@nl ;
        sh:node ob:Rule_fromLocation ;
    ] ;
    sh:property [
        sh:path sdo:toLocation ;
        sh:name "Eindlocatie van de gebeurtenis"@nl ;
        sh:node ob:Rule_toLocation ;
    ] ;
    sh:property [
        sh:path sdo:actor ;
        sh:name "Verwijzing van de gebeurtenis naar de persoonsvermelding waaraan hij is gekoppeld"@nl ;
        sh:node ob:Rule_actor ;
    ] ;
    sh:property [
        sh:path sdo:superEvent ;
        sh:name "Grotere gebeurtenis gerelateerd aan de persoonlijke gebeurtenis"@nl ;
        sh:node ob:Rule_superEvent ;
    ] ;
    sh:property [
        sh:path prov:hadPrimarySource ;
        sh:name "Bronrecord"@nl ;
        sh:description "Verwijzing naar het bronrecord waaruit persoonsvermelding en gebeurtenis afkomstig zijn."@nl ;
        sh:node ob:Rule_hadPrimarySource ;
    ] ;

    # --- Tijd ---
    sh:property [
        sh:path sdo:startDate ;
        sh:name "Begindatum"@nl ;
        sh:description "Begindatum van de gebeurtenis. Bij een gebeurtenis die plaatsvindt op één dag is dit de datum."@nl ;
        sh:node ob:Rule_startDate ;
    ] ;
    sh:property [
        sh:path sdo:endDate ;
        sh:name "Einddatum"@nl ;
        sh:description "Einddatum van de gebeurtenis."@nl ;
        sh:node ob:Rule_endDate ;
    ] .

### --- SUBCLASSES VOOR PERSOONLIJKE GEBEURTENISSEN ---
ob:PersonalEventShape a sh:NodeShape ;
    sh:targetClass ob:PersonalEvent ;
    sh:name "Persoonlijke gebeurtenissen"@nl ;
    sh:description "Typering van een gebeurtenis als persoonlijke gebeurtenis uit de WO2 thesaurus"@nl .
    
### --- AFBEELDINGEN BIJ PERSONEN ---
ob:ImageObjectShape a sh:NodeShape ;
    sh:targetClass sdo:ImageObject ;
    sh:name "Afbeeldingen bij personen"@nl ;
    sh:description "Afbeeldingen (archiefscans, maar ook portretten en andere foto's) die vanuit persoonsvermeldingen aan de persoon gekoppeld zijn"@nl ;
	
    # --- Kenmerken en Context ---
    sh:property [
        sh:path sdo:caption ;
        sh:name "Bijschrift"@nl ;
        sh:description "Bijschrift bij de afbeelding."@nl ;
        sh:node ob:Rule_caption ;
    ] ;
    sh:property [
        sh:path sdo:thumbnailUrl ;
        sh:name "Url van de afbeelding"@nl ;
        sh:description "Directe link naar de afbeelding (voor embedden etc.)."@nl ;
        sh:node ob:Rule_thumbnailUrl ;
    ] ;
    sh:property [
        sh:path sdo:associatedMedia ;
        sh:name "IIIF Manifest"@nl ;
        sh:description "Afbeelding(en) van de persoon via een IIIF Manifest."@nl ;
        sh:node ob:Rule_associatedMedia ;
    ] ;
    sh:property [
        sh:path sdo:url ;
        sh:name "Url van de bron"@nl ;
        sh:description "Verwijzing naar de bron waaruit de afbeelding afkomstig is."@nl ;
        sh:node ob:Rule_url ;
    ] .
    
### --- BRONNEN VOOR PERSONEN ---

## --- BRON ---
ob:SourceShape a sh:NodeShape ;
    sh:targetClass
        sdo:ArchiveComponent,
        prov:Entity ;
        sh:name "Bronrecords"@nl ;
        sh:description "Archiefstukken, maar ook records uit andere (onderzoeks)datasets en webpagina's die de bron zijn van persoonsvermeldingen."@nl ;
    
    sh:property [
        sh:path sdo:url ;
        sh:name "Url van het bronrecord"@nl ;
        sh:description "Verwijzing naar de url van de bron."@nl ;
        sh:node ob:Rule_url ;
    ] ;
    sh:property [
        sh:path sdo:image ;
        sh:name "Afbeelding"@nl ;
        sh:description "Verwijzing naar de scan(s) of andere afbeelding(en) die gekoppeld zijn aan het bronrecord."@nl ;
        sh:node ob:Rule_image ;
    ] ;
    sh:property [
        sh:path sdo:isPartOf ;
        sh:name "Dataset"@nl ;
        sh:description "Verwijzing naar de dataset waar de het bronrecord deel van uit maakt."@nl ;
        sh:node ob:Rule_isPartOf_source ;
    ] ;
    sh:property [
        sh:path sdo:holdingArchive ;
        sh:name "Bronleverancier"@nl ;
        sh:description "Verwijzing de leverancier van het bronrecord."@nl ;
        sh:node ob:Rule_holdingArchive ;
    ] .

## --- DATASET ---
ob:DatasetShape a sh:NodeShape ;
    sh:targetClass 
        sdo:Dataset ;
    sh:name "Datasets"@nl ;
    sh:description "Bronrecords  maken altijd onderdeel uit van een dataset."@nl ;
    
    # --- Identificatie ---
    sh:property [
        sh:path sdo:identifier ;
        sh:name "Identifier"@nl ;
        sh:description "De unieke identifier van de dataset."@nl ;
        sh:node ob:Rule_identifier ;
    ] ;

    # --- Kenmerken en context ---
    sh:property [
        sh:path sdo:name ;
        sh:name "Naam van de dataset"@nl ;
        sh:node ob:Rule_name ;
    ] ;
    sh:property [
        sh:path sdo:description ;
        sh:name "Beschrijving van de dataset"@nl ;
        sh:node ob:Rule_description ;
    ] ;
    sh:property [
        sh:path sdo:url ;
        sh:name "Verwijzing naar de url van de dataset"@nl ;
        sh:node ob:Rule_url ;
    ] ;
    sh:property [
        sh:path sdo:provider ;
        sh:name "Verwijzing naar de leverancier van de dataset"@nl ;
        sh:node ob:Rule_provider ;
    ] .