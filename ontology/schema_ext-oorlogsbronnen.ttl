@prefix ob: <https://data.oorlogsbronnen.nl/schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix niod: <https://data.niod.nl/WO2_Thesaurus/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix picom: <https://personsincontext.org/model#> .

# Dit bestand definieert classes en properties specifiek voor het domein oorlogsbronnen.nl

# Nederlandse labels for schema.org classes gebruikt in Oorlogsbronnen

# Nederlandse labels voor objecten

sdo:CreativeWork rdfs:label "Object"@nl .
sdo:Article rdfs:label "Krantenartikel"@nl . #TBD vervangen door sdo:NewsArticle
sdo:Newspaper rdfs:label "Krant"@nl .
sdo:Book rdfs:label "Boek"@nl .
sdo:Photograph rdfs:label "Foto"@nl .
sdo:VisualArtwork rdfs:label "Kunstwerk"@nl .
sdo:VideoObject rdfs:label "Video"@nl .
sdo:AudioObject rdfs:label "Audio"@nl .
sdo:ImageObject rdfs:label "Afbeelding"@nl .
sdo:Painting rdfs:label "Schilderij"@nl .
sdo:Sculpture rdfs:label "Beeldhouwwerk"@nl .
sdo:SheetMusic rdfs:label "Bladmuziek"@nl .
sdo:ArchiveComponent rdfs:label "Archiefmateriaal"@nl .

# Nederlandse labels voor personen en plaatsen

sdo:Person rdfs:label "Persoon"@nl .
sdo:Place rdfs:label "Locatie"@nl .

# Extra class tussen CreativeWork en specifieke subclasses voor collectie objecten met visuele component

ob:Afbeelding a rdfs:Class ;
	rdfs:label "Afbeelding"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Custom class voor alle collectie objecten met een afbeelding op oorlogsbronnen.nl"@nl .

ob:Archiefmateriaal a rdfs:Class ;
	rdfs:label "Archiefmateriaal"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Custom class voor het bundelen van archieven en archiefstukken op voor oorlogsbronnen.nl"@nl .
	
ob:Bekendmaking a rdfs:Class ;
	rdfs:label "Bekendmaking"@nl ;
	rdfs:subClassOf sdo:Event, ob:Afbeelding, sdo:CreativeWork ;
	rdfs:comment "Custom class voor historische bekendmakingen op oorlogsbronnen.nl"@nl .

skos:Concept a rdfs:Class ;
	rdfs:label "Thema"@nl ;
	rdfs:subClassOf ob:Webpagina ; # hack to get all thesaurus content available as webpagina
	rdfs:comment "Class for thesaurus concepts"@en .
	
<https://data.niod.nl/WO2_Thesaurus/6564> a rdfs:Class ;
	rdfs:label "Locatie"@nl ;
	rdfs:subClassOf sdo:Place, skos:Concept ;
	rdfs:comment "Custom class for Oorlogsbronnen locations (oorlogsplekken)"@en .

sdo:Photograph rdfs:subClassOf ob:Afbeelding .
sdo:ImageObject rdfs:subClassOf ob:Afbeelding .
sdo:VisualArtwork rdfs:subClassOf ob:Afbeelding .
sdo:SheetMusic rdfs:subClassOf ob:Afbeelding .

sdo:ArchiveComponent rdfs:subClassOf ob:Archiefmateriaal .

# Specifieke subclasses van sdo:CreativeWork

ob:Monument a rdfs:Class ;
	rdfs:label "Monument"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Custom class voor oorlogsmonumenten op oorlogsbronnen.nl"@nl .

ob:Archive a rdfs:Class ;
	rdfs:label "Archief"@nl ;
	rdfs:subClassOf sdo:ArchiveComponent ;
	rdfs:comment "Custom class voor archieven op oorlogsbronnen.nl"@nl .

ob:ArchiveFile a rdfs:Class ;
	rdfs:label "Archiefstuk"@nl ;
	rdfs:subClassOf sdo:ArchiveComponent ;
	rdfs:comment "Custom class voor archiefstukken op oorlogsbronnen.nl"@nl .

ob:Interview a rdfs:Class ;
	rdfs:label "Interview"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Custom class voor oral history interviews op oorlogsbronnen.nl"@nl .

ob:InterviewSegment a rdfs:Class ;
	rdfs:label "Fragment"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Custom class voor fragmenten van oral history interviews op oorlogsbronnen.nl"@nl .

ob:ClosedCaption a rdfs:Class ;
	rdfs:label "Interviewtranscriptie"@nl ;
	rdfs:subClassOf sdo:CreativeWork ;
	rdfs:comment "Transcriptie van audio of video in het tijdgebonden WebVTT-formaat"@nl ;

# Curated content

ob:Webpagina a rdfs:Class ;
	rdfs:label "Webpagina"@nl ;
	rdfs:comment "Custom class voor artikelen en andere web content gecreëerd door Oorlogsbronnen/WO2Net"@nl .

sdo:WebPage rdfs:subClassOf ob:Webpagina .

# More specific classes of sdo:Event

ob:PersonalEvent a rdfs:Class ;
	rdfs:label "Persoonlijke gebeurtenis"@nl ;
	rdfs:subClassOf sdo:Event ;
	rdfs:comment "Gebeurtenissen in het leven van een persoon (life events) krijgen een specifieke subclass, zoals Gearresteerd of Bevrijd. De typen komen uit de WO2 Thesaurus en worden gebruikt als sdo:additionalType van de gebeurtenis."@nl ;

niod:Gevangen a rdfs:Class ;
    rdfs:label "Gevangen"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Gevangenschap van burgers in (concentratie)kampen en gevangenissen. Voor krijgsgevangenen gebruiken we 'Geïnterneerd'. Ook voor gevangen burgers uit Nederlands-Indië wordt de term 'Geïnterneerd' gebruikt"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6354> .

niod:BevrijdUit a rdfs:Class ;
    rdfs:label "Bevrijd uit"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Bevrijd worden uit een kamp of gevangenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6347> .

niod:Gearresteerd a rdfs:Class ;
    rdfs:label "Gearresteerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Aangehouden of gearresteerd worden"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6344> .

niod:Ontsnapt a rdfs:Class ;
    rdfs:label "Ontsnapt"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Ontsnappen uit een kamp of gevangenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/8795> .

niod:Opgepakt a rdfs:Class ;
    rdfs:label "Opgepakt"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Opgepakt worden zonder dat daarna een juridisch traject volgt. Meestal gebruikt voor personen die (willekeurig) aangehouden zijn tijdens razzia's en repressailles"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6345> .

niod:Getransporteerd a rdfs:Class ;
    rdfs:label "Getransporteerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Gedwongen getransporteerd worden van of naar een (concentratie)kamp of gevangenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6348> .

niod:Tewerkgesteld a rdfs:Class ;
    rdfs:label "Tewerkgesteld"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Gedwongen tewerkgesteld worden. Tijdens de Tweede Wereldoorlog werden ruim een half miljoen Nederlandse mannen gedwongen om als dwangarbeider in nazi-Duitsland te werken. Dit systeem stond bekend als de Arbeitseinsatz (arbeidsinzet)"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/8514> .

niod:Teruggekeerd a rdfs:Class ;
    rdfs:label "Teruggekeerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Terugkeren uit een (concentratie)kamp of gevangenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/18496> .

niod:Gevlucht a rdfs:Class ;
    rdfs:label "Gevlucht"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Vluchten voor een gevaar of dreiging"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6353> .


niod:Vrijgelaten a rdfs:Class ;
    rdfs:label "Vrijgelaten"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Vrijgelaten worden uit een (concentratie)kamp of gevangenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6346> .

niod:LidGeweest a rdfs:Class ;
    rdfs:label "Lid geweest"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Lidmaatschap van een partij, groep of organisatie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6352> .

niod:Overleden a rdfs:Class ;
    rdfs:label "Overleden"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Overlijden van een persoon in de meest neutrale vorm. Indien de oorzaak van overlijden bekend is wordt deze beschreven in de beschrijving (sdo:description) van de gebeurtenis"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/8771> .

niod:Verraden a rdfs:Class ;
    rdfs:label "Verraden"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Verraden worden. Het gaat hier om de persoon die verraden is"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6358> .

niod:Getroffen a rdfs:Class ;
    rdfs:label "Getroffen"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Getroffen worden. Het gaat hier om het slachtoffer van een gebeurtenis of kogel"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6356> .

niod:Geïnterneerd a rdfs:Class ;
    rdfs:label "Geïnterneerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Geïnterneerd verwijst naar militairen die gevangen zitten in kampen of gevangenissen. Ook naar burgers in Nederlands-Indië die gevangen zitten in kampen wordt verwezen als geïnterneerden. Voor alle overige burgers in kampen en gevangenissen gebruiken we 'Gevangen'"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6349> .

niod:Afgepakt a rdfs:Class ;
    rdfs:label "Afgepakt"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Afgepakt betreft het afnemen van roerende of onroerende bezittingen van de eigenaar"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/19486> .

niod:Opgeroepen a rdfs:Class ;
    rdfs:label "Opgeroepen"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Opgeroepen worden voor dienst of gedwongen tewerkstelling"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/8542> .

niod:Opgericht a rdfs:Class ;
    rdfs:label "Opgericht"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het oprichten van een partij, groep of organisatie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/13792> .

niod:Benoemd a rdfs:Class ;
    rdfs:label "Benoemd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Benoemd worden in een functie of rang"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/13790> .

niod:Veroordeeld a rdfs:Class ;
    rdfs:label "Veroordeeld"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Veroordeeld worden tot een straf"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6563> .

niod:Geleid a rdfs:Class ;
    rdfs:label "Geleid"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Leider zijn van een partij, groep of organisatie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11182> .

niod:Arresteert a rdfs:Class ;
    rdfs:label "Arresteert"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het arresteren of oppakken van personen"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11179> .

niod:Gerecruteerd a rdfs:Class ;
    rdfs:label "Gerecruteerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Geworven worden voor militaire of geheime diensten"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6362> .

niod:Vertrokken a rdfs:Class ;
    rdfs:label "Vertrokken"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Vertrekken uit een land of plaats"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/13791> .

niod:Vrijgesproken a rdfs:Class ;
    rdfs:label "Vrijgesproken"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Door een rechtbank vrijgesproken worden van veroordeling"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/14203> .

niod:Gevochten a rdfs:Class ;
    rdfs:label "Gevochten"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Deelgenomen hebben aan een gevechtsactie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6359> .

niod:Verraadt a rdfs:Class ;
    rdfs:label "Verraadt"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het verraden van een ander persoon"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11177> .

niod:Gedecoreerd a rdfs:Class ;
    rdfs:label "Gedecoreerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Gedecoreerd of onderscheiden worden"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6365> .

niod:Geroyeerd a rdfs:Class ;
    rdfs:label "Geroyeerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Geroyeerd worden als lid van een een partij, groep of organisatie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11178> .

niod:Ondergedoken a rdfs:Class ;
    rdfs:label "Ondergedoken"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Op een geheime plek schuilhouden om uit handen van de autoriteiten of de bezetter te blijven"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6351> .

niod:Executeert a rdfs:Class ;
    rdfs:label "Executeert"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het uitvoeren van een executie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11176> .

niod:Opgevangen a rdfs:Class ;
    rdfs:label "Opgevangen"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Opgevangen worden na gedwongen verplaatsing of ontheemding"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/10956> .

niod:Gevaren a rdfs:Class ;
    rdfs:label "Gevaren"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Reis over zee gemaakt. Van toepassing op Engelandvaarders"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11181> .

niod:BevrijdIn a rdfs:Class ;
    rdfs:label "Bevrijd in"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Verwijst naar de plaats of het land waarin een persoon bevrijd wordt"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11173> .

niod:Geland a rdfs:Class ;
    rdfs:label "Geland"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het aan land komen (zowel per boot als vliegtuig) van een persoon"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6363> .

niod:Gepleegd a rdfs:Class ;
    rdfs:label "Gepleegd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het uitvoeren van een (ondermijnende) activiteit, zoals een aanslag of overval"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6355> .

niod:OpPadGegaan a rdfs:Class ;
    rdfs:label "Op pad gegaan"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Vertrekken van een locatie"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/17064> .

niod:Vrijgesteld a rdfs:Class ;
    rdfs:label "Vrijgesteld"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Vrijgesteld worden van dienst of een andere verplichte activiteit"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/6562> .

niod:Geevacueerd a rdfs:Class ;
    rdfs:label "Geëvacueerd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Tijdelijk worden weggehaald uit een gevaarlijk gebied"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/11174> .

niod:Vermist a rdfs:Class ;
    rdfs:label "Vermist"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Het is niet duidelijk waar de persoon zich bevindt"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/events/10946> .

niod:GedwongenVerhuisd a rdfs:Class ;
    rdfs:label "Gedwongen verhuisd"@nl ;
    rdfs:subClassOf sdo:Event, ob:PersonalEvent ;
    rdfs:comment "Onder dwang moeten verhuizen"@nl ;
    rdfs:isDefinedBy <https://data.niod.nl/WO2_Thesaurus/19198> .

# Properties for 'Bekendmakingen'

ob:slachtoffer a rdf:Property ;
	rdfs:label "slachtoffer"@nl ;
	rdfs:subPropertyOf sdo:actor ;
	rdfs:comment "Een persoon die getroffen werd door de effecten van een bekendmaking"@nl .

ob:opdrachtgever a rdf:Property ;
	rdfs:label "opdrachtgever"@nl ;
	rdfs:subPropertyOf sdo:actor ;
	rdfs:comment "Een persoon die de opdrachtgever was van een bekendmaking"@nl .

ob:genoemde a rdf:Property ;
	rdfs:label "genoemde"@nl ;
	rdfs:subPropertyOf sdo:actor ;
	rdfs:comment "Een persoon die genoemd wordt bij een bekendmaking"@nl .

# Class for rights statements

ob:Rights a rdfs:Class ;
	rdfs:label "Rechten"@nl ;
	rdfs:comment "Class waarmee rechtenverklaringen uit verschillende bronnen zoals rightsstatements.org en creativecommons met elkaar verbonden worden"@nl .

# Classes for persons from Persons In Context

picom:PersonObservation a rdfs:Class ;
        rdfs:label "Persoonsvermelding"@nl ;
        rdfs:comment "Persoon zoals geobserveerd in een bron"@nl .
    
picom:PersonReconstruction a rdfs:Class ;
        rdfs:label "Persoonsreconstructie"@nl ;
        rdfs:comment "Persoon gemodelleerd op basis van een of meer persoonsvermeldingen"@nl .
